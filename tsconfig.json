{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"composite": false,
		"declaration": true,
		"declarationMap": true,
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": false,
		"sourceMap": true,
		"strict": true,
		"target": "ES2024",
		"types": ["node"]
	},
	"include": [
		"apps/**/*.ts",
		"packages/**/*.ts",
		"plugins/**/*.ts",
		"tests/**/*.ts"
	]
}
